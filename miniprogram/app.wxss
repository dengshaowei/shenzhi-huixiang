page {
  --bg: #fff7ed;
  --surface: #ffffff;
  --surface-soft: #fffbf5;
  --surface-warm: #fffbf5;
  --line: #f1d6c2;
  --text: #3b2416;
  --muted: #7c5c4a;
  --primary: #c2410c;
  --primary-soft: #ffedd5;
  --orange: #fb923c;
  --coral: #fb7185;
  --coral-soft: #ffe4e6;
  --sun: #facc15;
  --sun-soft: #fef9c3;
  --success: #2f7d61;
  --success-soft: #ddf5e9;
  --danger: #b42318;
  --danger-soft: #fee4e2;
  --mint: var(--primary);
  --cyan: var(--orange);
  --amber: var(--sun);
  min-height: 100%;
  background: var(--bg);
  color: var(--text);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
}

view,
text,
button,
textarea {
  box-sizing: border-box;
}

.page-shell {
  position: relative;
  min-height: 100vh;
  padding: 36rpx 28rpx calc(62rpx + env(safe-area-inset-bottom));
  overflow: hidden;
  background:
    radial-gradient(circle at 92% 2%, rgba(251, 113, 133, 0.18), transparent 24%),
    radial-gradient(circle at 3% 16%, rgba(250, 204, 21, 0.18), transparent 23%),
    linear-gradient(180deg, #fff7ed 0%, #fffaf4 54%, #fff3e5 100%);
}

.page-shell::before,
.page-shell::after {
  position: absolute;
  z-index: 0;
  border-radius: 50%;
  pointer-events: none;
  content: "";
}

.page-shell::before {
  top: 154rpx;
  right: -72rpx;
  width: 168rpx;
  height: 168rpx;
  border: 22rpx solid rgba(251, 146, 60, 0.09);
}

.page-shell::after {
  top: 208rpx;
  right: -18rpx;
  width: 50rpx;
  height: 50rpx;
  background: rgba(251, 113, 133, 0.13);
}

.page-shell > view,
.page-shell > text,
.page-shell > button {
  position: relative;
  z-index: 1;
  animation: rise-in 360ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
}

.page-shell > view:nth-child(2),
.page-shell > text:nth-child(2),
.page-shell > button:nth-child(2) { animation-delay: 35ms; }
.page-shell > view:nth-child(3),
.page-shell > text:nth-child(3),
.page-shell > button:nth-child(3) { animation-delay: 70ms; }
.page-shell > view:nth-child(4),
.page-shell > text:nth-child(4),
.page-shell > button:nth-child(4) { animation-delay: 105ms; }
.page-shell > view:nth-child(5),
.page-shell > text:nth-child(5),
.page-shell > button:nth-child(5) { animation-delay: 140ms; }

.eyebrow {
  display: inline-flex;
  align-items: center;
  min-height: 42rpx;
  margin-bottom: 16rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  color: var(--primary);
  font-size: 20rpx;
  font-weight: 800;
  letter-spacing: 3rpx;
  background: var(--primary-soft);
}

.page-title {
  display: block;
  max-width: 650rpx;
  color: var(--text);
  font-size: 52rpx;
  font-weight: 850;
  line-height: 1.18;
  letter-spacing: -1rpx;
}

.page-subtitle {
  display: block;
  max-width: 660rpx;
  margin-top: 18rpx;
  color: var(--muted);
  font-size: 27rpx;
  line-height: 1.68;
}

.section-title {
  display: block;
  margin: 46rpx 0 20rpx;
  color: var(--text);
  font-size: 32rpx;
  font-weight: 800;
}

.card {
  margin-top: 22rpx;
  padding: 30rpx;
  border: 1rpx solid rgba(241, 214, 194, 0.9);
  border-radius: 36rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 20rpx 56rpx rgba(124, 70, 30, 0.1);
}

.card-title {
  display: block;
  color: var(--text);
  font-size: 31rpx;
  font-weight: 800;
  line-height: 1.38;
}

.card-copy {
  display: block;
  margin-top: 12rpx;
  color: var(--muted);
  font-size: 26rpx;
  line-height: 1.72;
}

.primary-button,
.secondary-button,
.danger-button {
  width: 100%;
  min-height: 92rpx;
  margin-top: 24rpx;
  border-radius: 28rpx;
  font-size: 29rpx;
  font-weight: 800;
  line-height: 92rpx;
  transition: transform 180ms ease, background-color 180ms ease, box-shadow 180ms ease;
}

.primary-button {
  color: #ffffff;
  background: var(--primary);
  box-shadow: 0 16rpx 34rpx rgba(194, 65, 12, 0.22);
}

.secondary-button {
  border: 1rpx solid rgba(194, 65, 12, 0.16);
  color: var(--primary);
  background: var(--primary-soft);
}

.danger-button {
  border: 1rpx solid rgba(180, 35, 24, 0.18);
  color: var(--danger);
  background: var(--danger-soft);
}

.primary-button:active,
.secondary-button:active,
.danger-button:active {
  transform: scale(0.97);
}

.primary-button:active {
  background: var(--text);
  box-shadow: 0 8rpx 18rpx rgba(59, 36, 22, 0.18);
}

button::after { border: 0; }

button[disabled] {
  opacity: 0.6;
}

.pill {
  display: inline-flex;
  align-items: center;
  min-height: 48rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  color: var(--text);
  font-size: 21rpx;
  font-weight: 750;
  background: var(--sun-soft);
}

.muted { color: var(--muted); }

.error-banner {
  margin-top: 20rpx;
  padding: 22rpx 24rpx;
  border: 1rpx solid rgba(180, 35, 24, 0.18);
  border-radius: 24rpx;
  color: var(--danger);
  font-size: 24rpx;
  line-height: 1.55;
  background: var(--danger-soft);
}

textarea {
  caret-color: var(--primary);
}

textarea::placeholder {
  color: #a88773;
}

@keyframes rise-in {
  from { opacity: 0; transform: translateY(14rpx); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes soft-pulse {
  0%, 100% { opacity: 0.55; transform: scale(0.96); }
  50% { opacity: 1; transform: scale(1.04); }
}

@keyframes echo-ring {
  from { opacity: 0.48; transform: scale(0.72); }
  to { opacity: 0; transform: scale(1.42); }
}

@media (prefers-reduced-motion: reduce) {
  .page-shell > view,
  .page-shell > text,
  .page-shell > button,
  .primary-button,
  .secondary-button,
  .danger-button {
    animation: none !important;
    transition: none !important;
  }
}

/* 点亮 / 迁移成功庆祝层：纯 WXSS 动效，无图片资源 */
.celebration-mask { position: fixed; top: 0; right: 0; bottom: 0; left: 0; z-index: 90; display: flex; align-items: center; justify-content: center; background: rgba(59, 36, 22, 0.55); animation: celebration-fade 0.3s ease-out; }
@keyframes celebration-fade { from { opacity: 0; } to { opacity: 1; } }
.celebration-card { position: relative; z-index: 2; width: 560rpx; padding: 56rpx 44rpx 44rpx; text-align: center; border-radius: 36rpx; background: linear-gradient(180deg, #fffaf2 0%, #ffffff 100%); box-shadow: 0 30rpx 80rpx rgba(59, 36, 22, 0.35); animation: celebration-pop 0.45s cubic-bezier(0.2, 1.6, 0.4, 1); }
@keyframes celebration-pop { from { opacity: 0; transform: scale(0.6) translateY(60rpx); } to { opacity: 1; transform: scale(1) translateY(0); } }
.celebration-emoji { display: block; font-size: 96rpx; animation: celebration-wiggle 1.4s ease-in-out infinite; }
@keyframes celebration-wiggle { 0%, 100% { transform: rotate(-6deg) scale(1); } 50% { transform: rotate(6deg) scale(1.12); } }
.celebration-title { display: block; margin-top: 20rpx; color: var(--primary); font-size: 40rpx; font-weight: 900; }
.celebration-copy { display: block; margin-top: 16rpx; color: var(--muted); font-size: 24rpx; line-height: 1.6; }
.celebration-button { margin-top: 36rpx; padding: 0 40rpx; border-radius: 999rpx; color: #ffffff; font-size: 26rpx; font-weight: 800; line-height: 84rpx; background: var(--primary); box-shadow: 0 14rpx 30rpx rgba(194, 65, 12, 0.3); }
.celebration-button::after { border: 0; }
.confetti { position: absolute; top: 0; right: 0; bottom: 0; left: 0; z-index: 1; overflow: hidden; pointer-events: none; }
.confetti-piece { position: absolute; top: -40rpx; width: 18rpx; height: 28rpx; border-radius: 6rpx; animation: confetti-fall linear infinite; }
@keyframes confetti-fall { from { transform: translateY(-60rpx) rotate(0deg); } to { transform: translateY(1400rpx) rotate(720deg); } }
.piece-1 { left: 8%; background: var(--sun); animation-duration: 3.1s; }
.piece-2 { left: 18%; background: var(--coral); animation-duration: 2.6s; animation-delay: 0.4s; }
.piece-3 { left: 27%; background: var(--orange); animation-duration: 3.5s; animation-delay: 0.9s; }
.piece-4 { left: 36%; background: var(--primary); animation-duration: 2.9s; animation-delay: 0.2s; }
.piece-5 { left: 45%; background: var(--sun); animation-duration: 3.8s; animation-delay: 1.1s; }
.piece-6 { left: 54%; background: var(--coral); animation-duration: 2.7s; animation-delay: 0.6s; }
.piece-7 { left: 63%; background: var(--orange); animation-duration: 3.3s; animation-delay: 1.3s; }
.piece-8 { left: 72%; background: var(--success); animation-duration: 2.8s; animation-delay: 0.8s; }
.piece-9 { left: 81%; background: var(--sun); animation-duration: 3.6s; animation-delay: 0.3s; }
.piece-10 { left: 90%; background: var(--coral); animation-duration: 3s; animation-delay: 1s; }
.piece-11 { left: 50%; background: var(--success); animation-duration: 3.4s; animation-delay: 1.5s; }
.piece-12 { left: 13%; background: var(--primary); animation-duration: 2.5s; animation-delay: 1.7s; }
