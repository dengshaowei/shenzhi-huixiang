.agent-page { display: flex; flex-direction: column; height: 100vh; color: var(--text); background: linear-gradient(180deg, #fff7ed 0%, #fffaf4 100%); }
.agent-context { display: flex; align-items: center; justify-content: space-between; padding: 24rpx 28rpx 22rpx; border-bottom: 1rpx solid var(--line); background: rgba(255, 255, 255, 0.94); }
.context-label { display: block; color: var(--primary); font-size: 18rpx; font-weight: 800; letter-spacing: 2rpx; }
.context-title { display: block; margin-top: 8rpx; font-size: 28rpx; font-weight: 900; }
.context-module { display: block; margin-top: 4rpx; color: var(--muted); font-size: 21rpx; }
.change-context { min-height: 62rpx; margin: 0; padding: 0 18rpx; border: 1rpx solid rgba(194, 65, 12, 0.18); border-radius: 20rpx; color: var(--primary); font-size: 21rpx; font-weight: 800; line-height: 62rpx; background: var(--primary-soft); }
.change-context::after { border: 0; }
.message-list { flex: 1; min-height: 0; }
.message-padding { padding: 24rpx 24rpx 220rpx; }
.message-row { display: flex; align-items: flex-start; margin-bottom: 28rpx; }
.message-row--user { flex-direction: row-reverse; }
.avatar { display: flex; align-items: center; justify-content: center; flex: 0 0 58rpx; width: 58rpx; height: 58rpx; margin: 0 14rpx; border-radius: 20rpx; color: #ffffff; font-size: 22rpx; font-weight: 900; background: var(--primary); box-shadow: 0 8rpx 18rpx rgba(194, 65, 12, 0.18); }
.message-row--user .avatar { color: var(--text); background: var(--sun); box-shadow: none; }
.avatar--agent { animation: avatar-breathe 3.2s ease-in-out infinite; }
@keyframes avatar-breathe { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.06); } }
.message-bubble { max-width: 560rpx; padding: 22rpx; border: 1rpx solid var(--line); border-radius: 12rpx 28rpx 28rpx 28rpx; background: #ffffff; box-shadow: 0 12rpx 30rpx rgba(124, 70, 30, 0.07); }
.message-row--user .message-bubble { border-radius: 28rpx 12rpx 28rpx 28rpx; background: var(--primary-soft); }
.message-bubble--thinking { background: var(--surface-soft); }
.thinking-row { display: flex; align-items: center; margin-top: 10rpx; }
.thinking-dots { display: flex; align-items: center; }
.thinking-dots .dot { width: 12rpx; height: 12rpx; margin-right: 8rpx; border-radius: 50%; background: var(--primary); animation: dot-bounce 1.2s ease-in-out infinite; }
.thinking-dots .dot:nth-child(2) { animation-delay: 0.15s; }
.thinking-dots .dot:nth-child(3) { animation-delay: 0.3s; }
@keyframes dot-bounce { 0%, 100% { opacity: 0.35; transform: translateY(0); } 50% { opacity: 1; transform: translateY(-8rpx); } }
.thinking-text { color: var(--muted); font-size: 21rpx; }
.message-role { display: block; color: var(--primary); font-size: 18rpx; font-weight: 800; }
.message-text { display: block; margin-top: 10rpx; white-space: pre-wrap; font-size: 24rpx; line-height: 1.65; }
.answer-mindmap { position: relative; margin-top: 20rpx; padding: 18rpx 14rpx; border-radius: 24rpx; background: var(--surface-soft); }
.answer-map-root { padding: 18rpx; text-align: center; border: 3rpx solid var(--primary); border-radius: 22rpx; background: #ffffff; }
.answer-root-label { display: block; color: var(--primary); font-size: 16rpx; font-weight: 800; letter-spacing: 2rpx; }
.answer-root-title { display: block; margin-top: 6rpx; color: var(--text); font-size: 25rpx; font-weight: 900; }
.answer-root-summary { display: block; margin-top: 6rpx; color: var(--muted); font-size: 18rpx; line-height: 1.45; }
.answer-map-trunk { width: 4rpx; height: 22rpx; margin: 0 auto; background: var(--line); }
.answer-map-branch { position: relative; padding: 7rpx 0 7rpx 24rpx; }
.answer-map-branch::before { position: absolute; top: 0; bottom: 0; left: 7rpx; width: 3rpx; content: ""; background: var(--line); }
.answer-map-branch:last-child::before { bottom: auto; height: 34rpx; }
.answer-branch-line { position: absolute; top: 34rpx; left: 7rpx; width: 22rpx; height: 3rpx; background: var(--primary); }
.answer-branch-card { padding: 16rpx; border: 1rpx solid var(--line); border-left: 6rpx solid var(--primary); border-radius: 18rpx; background: #ffffff; }
.answer-branch-title { display: block; color: var(--primary); font-size: 20rpx; font-weight: 900; }
.answer-point-row { display: flex; align-items: flex-start; margin-top: 10rpx; }
.answer-point-dot { flex: 0 0 9rpx; width: 9rpx; height: 9rpx; margin: 11rpx 11rpx 0 0; border-radius: 50%; background: var(--orange); }
.answer-point-text { flex: 1; color: var(--text); font-size: 20rpx; line-height: 1.55; }
.follow-up-card { margin-top: 18rpx; padding: 16rpx; border-radius: 18rpx; background: var(--sun-soft); }
.follow-up-label { display: block; color: var(--primary); font-size: 18rpx; font-weight: 800; }
.follow-up-text { display: block; margin-top: 6rpx; color: var(--text); font-size: 21rpx; line-height: 1.5; }
.evidence-note { display: block; margin-top: 14rpx; color: var(--success); font-size: 17rpx; }
.suggestion-row { display: flex; flex-wrap: wrap; margin-top: 16rpx; }
.suggestion-chip { min-height: 54rpx; margin: 0 10rpx 10rpx 0; padding: 0 16rpx; border: 1rpx solid rgba(194, 65, 12, 0.2); border-radius: 999rpx; color: var(--primary); font-size: 19rpx; font-weight: 700; line-height: 54rpx; background: #fffaf2; }
.suggestion-chip::after { border: 0; }
.message-meta { display: flex; align-items: center; justify-content: space-between; margin-top: 4rpx; }
.source-tag { margin-top: 14rpx; padding: 4rpx 12rpx; border-radius: 999rpx; font-size: 16rpx; font-weight: 800; }
.source-tag--cloud { color: var(--success); background: rgba(22, 163, 74, 0.1); }
.source-tag--local { color: var(--muted); background: rgba(124, 70, 30, 0.08); }
.not-grounded { display: block; margin-top: 14rpx; color: var(--danger); font-size: 19rpx; }
.feedback-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 10rpx; margin-top: 16rpx; padding-top: 14rpx; border-top: 1rpx solid var(--line); }
.feedback-prompt { flex: 1 0 100%; color: var(--muted); font-size: 17rpx; }
.feedback-button { min-height: 48rpx; margin: 0; padding: 0 16rpx; border: 1rpx solid var(--line); border-radius: 999rpx; color: var(--muted); font-size: 18rpx; line-height: 48rpx; background: #ffffff; }
.feedback-button::after { border: 0; }
.feedback-button.is-selected { color: var(--primary); border-color: var(--primary); background: var(--primary-soft); }
.agent-composer { position: fixed; right: 0; bottom: 0; left: 0; z-index: 20; padding: 14rpx 22rpx calc(16rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid var(--line); background: rgba(255, 251, 245, 0.98); box-shadow: 0 -14rpx 36rpx rgba(124, 70, 30, 0.09); }
.prompt-scroll { width: 100%; white-space: nowrap; }
.prompt-row { display: inline-flex; padding-right: 20rpx; }
.prompt-button { display: inline-flex; min-height: 58rpx; margin: 0 12rpx 0 0; padding: 0 18rpx; border: 1rpx solid var(--line); border-radius: 999rpx; color: var(--primary); font-size: 20rpx; font-weight: 800; line-height: 58rpx; background: #ffffff; }
.prompt-button::after { border: 0; }
.composer-row { display: flex; align-items: flex-end; margin-top: 12rpx; }
.chat-input { flex: 1; min-height: 76rpx; max-height: 170rpx; padding: 18rpx 20rpx; border: 1rpx solid var(--line); border-radius: 24rpx; font-size: 23rpx; line-height: 1.5; background: #ffffff; }
.send-button { flex: 0 0 112rpx; min-height: 76rpx; margin: 0 0 0 12rpx; border-radius: 24rpx; color: #ffffff; font-size: 23rpx; font-weight: 800; line-height: 76rpx; background: var(--primary); }
.send-button::after { border: 0; }
.composer-actions { display: flex; align-items: center; justify-content: space-between; margin-top: 10rpx; color: var(--muted); font-size: 17rpx; }
.action-link { margin-left: 22rpx; color: var(--primary); font-size: 20rpx; font-weight: 800; }

.tools-note { color: #8a6d00; background: var(--sun-soft); padding: 4rpx 14rpx; border-radius: 999rpx; }
