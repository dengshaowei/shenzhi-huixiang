.task-card { position: relative; overflow: hidden; }
.task-card::before { position: absolute; top: 0; left: 0; width: 10rpx; height: 100%; background: var(--orange); content: ""; }
.task-card:nth-of-type(2)::before { background: var(--coral); }
.task-head { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; }
.task-state { padding: 9rpx 14rpx; border-radius: 999rpx; color: var(--primary); font-size: 20rpx; font-weight: 700; background: var(--primary-soft); }
.task-title { margin-top: 22rpx; }
.task-meta { display: flex; justify-content: space-between; gap: 20rpx; margin-top: 22rpx; color: var(--muted); font-size: 20rpx; }
.locked-card { opacity: 0.72; box-shadow: none; }
.rule-card { margin-top: 30rpx; border-color: rgba(250, 204, 21, 0.44); background: linear-gradient(145deg, #ffffff, var(--sun-soft)); }
.rule-line { display: block; margin-top: 16rpx; padding: 12rpx 16rpx; border-radius: 18rpx; color: var(--text); font-size: 24rpx; background: rgba(255, 255, 255, 0.7); }
