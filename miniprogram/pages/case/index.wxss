.case-title { margin-top: 20rpx; }
.locked-notice { border-color: rgba(250, 204, 21, 0.45); background: linear-gradient(145deg, #ffffff, var(--sun-soft)); }
.case-brief { border-color: rgba(251, 113, 133, 0.26); background: linear-gradient(145deg, #ffffff, var(--coral-soft)); }
.option-card { margin-top: 16rpx; padding: 26rpx; border: 1rpx solid var(--line); border-radius: 30rpx; background: var(--surface-warm); box-shadow: 0 10rpx 24rpx rgba(124, 70, 30, 0.05); transition: transform 180ms ease, background-color 180ms ease; }
.option-card:active { transform: scale(0.97); }
.option-card.selected { border-color: rgba(194, 65, 12, 0.58); background: var(--primary-soft); box-shadow: 0 14rpx 30rpx rgba(194, 65, 12, 0.1); }
.option-title { display: block; color: var(--text); font-size: 27rpx; font-weight: 800; }
.option-copy { display: block; margin-top: 8rpx; color: var(--muted); font-size: 22rpx; line-height: 1.5; }
.reason-input { width: 100%; min-height: 240rpx; padding: 26rpx; border: 1rpx solid var(--line); border-radius: 30rpx; color: var(--text); font-size: 25rpx; line-height: 1.65; background: #ffffff; }
.reason-input:focus { border-color: var(--primary); }
.input-meta { display: flex; justify-content: space-between; margin-top: 10rpx; color: #9a7966; font-size: 20rpx; }
.feedback-card { position: relative; overflow: hidden; }
.feedback-card.passed { border-color: rgba(47, 125, 97, 0.3); background: linear-gradient(145deg, #ffffff, var(--success-soft)); }
.feedback-card.failed { border-color: rgba(250, 204, 21, 0.42); background: linear-gradient(145deg, #ffffff, var(--sun-soft)); }
.feedback-label { display: inline-flex; padding: 8rpx 14rpx; border-radius: 999rpx; color: var(--success); font-size: 21rpx; font-weight: 850; letter-spacing: 2rpx; background: var(--success-soft); }
.failed .feedback-label { color: var(--text); background: var(--sun); }
.feedback-title { margin-top: 14rpx; }
.agent-mode { display: inline-flex; margin-top: 22rpx; padding: 8rpx 14rpx; border-radius: 999rpx; color: var(--primary); font-size: 19rpx; font-weight: 800; background: var(--primary-soft); }
.follow-up { display: block; margin-top: 12rpx; color: var(--text); font-size: 23rpx; line-height: 1.55; }
.case-evidence { display: block; margin-top: 16rpx; color: var(--success); font-size: 19rpx; }
