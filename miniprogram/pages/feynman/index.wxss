.feynman-page { padding-bottom: 78rpx; }
.scenario-card { border-color: rgba(251, 146, 60, 0.28); background: linear-gradient(145deg, #ffffff, var(--primary-soft)); }
.scenario-title { margin-top: 20rpx; }
.prompt-copy { display: block; margin-top: -4rpx; color: var(--muted); font-size: 25rpx; line-height: 1.65; }
.option-card { display: flex; gap: 20rpx; margin-top: 16rpx; padding: 26rpx; border: 1rpx solid var(--line); border-radius: 30rpx; background: var(--surface-warm); box-shadow: 0 10rpx 24rpx rgba(124, 70, 30, 0.05); transition: transform 180ms ease, background-color 180ms ease, border-color 180ms ease; }
.option-card:active { transform: scale(0.97); }
.option-card.selected { border-color: rgba(194, 65, 12, 0.58); background: var(--primary-soft); box-shadow: 0 14rpx 30rpx rgba(194, 65, 12, 0.1); }
.option-card.submitted { opacity: 0.82; }
.radio-dot { display: flex; align-items: center; justify-content: center; flex: 0 0 40rpx; width: 40rpx; height: 40rpx; margin-top: 2rpx; border: 2rpx solid #c8a68f; border-radius: 50%; background: #ffffff; }
.selected .radio-dot { border-color: var(--primary); }
.selected .radio-dot > view { width: 22rpx; height: 22rpx; border-radius: 50%; background: var(--primary); }
.option-content { flex: 1; }
.option-title { display: block; color: var(--text); font-size: 27rpx; font-weight: 800; }
.option-copy { display: block; margin-top: 8rpx; color: var(--muted); font-size: 22rpx; line-height: 1.5; }
.answer-input { width: 100%; min-height: 280rpx; margin-top: 18rpx; padding: 26rpx; border: 1rpx solid var(--line); border-radius: 30rpx; color: var(--text); font-size: 25rpx; line-height: 1.65; background: #ffffff; box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.65); }
.answer-input:focus { border-color: var(--primary); }
.input-meta { display: flex; justify-content: space-between; margin-top: 10rpx; color: #9a7966; font-size: 20rpx; }
.result-section { margin-top: 34rpx; }
.result-hero { position: relative; overflow: hidden; }
.result-hero.unlocked { border-color: rgba(47, 125, 97, 0.32); background: linear-gradient(145deg, #ffffff, var(--success-soft)); }
.result-hero.unlocked::after { position: absolute; right: -30rpx; bottom: -30rpx; width: 120rpx; height: 120rpx; border: 16rpx solid rgba(47, 125, 97, 0.16); border-radius: 50%; content: ""; animation: echo-ring 850ms ease-out 1; }
.result-hero.not-yet { border-color: rgba(250, 204, 21, 0.42); background: linear-gradient(145deg, #ffffff, var(--sun-soft)); }
.result-kicker { display: inline-flex; padding: 8rpx 14rpx; border-radius: 999rpx; color: var(--success); font-size: 21rpx; font-weight: 850; letter-spacing: 2rpx; background: var(--success-soft); }
.not-yet .result-kicker { color: var(--text); background: var(--sun); }
.result-title { margin-top: 14rpx; }
.choice-result { display: inline-flex; margin-top: 20rpx; padding: 10rpx 16rpx; border-radius: 999rpx; color: var(--primary); font-size: 23rpx; font-weight: 800; background: var(--primary-soft); }
.dimension-row { display: flex; gap: 18rpx; margin-top: 14rpx; padding: 24rpx; border: 1rpx solid var(--line); border-radius: 26rpx; background: #ffffff; }
.dimension-row.passed { border-color: rgba(47, 125, 97, 0.24); background: linear-gradient(145deg, #ffffff, var(--success-soft)); }
.dimension-row.failed { border-color: rgba(250, 204, 21, 0.42); background: linear-gradient(145deg, #ffffff, var(--sun-soft)); }
.dimension-icon { display: flex; align-items: center; justify-content: center; flex: 0 0 42rpx; width: 42rpx; height: 42rpx; border-radius: 50%; color: #ffffff; font-size: 22rpx; font-weight: 900; background: var(--success); }
.dimension-row.failed .dimension-icon { color: var(--text); background: var(--sun); }
.dimension-label { display: block; color: var(--text); font-size: 25rpx; font-weight: 800; }
.dimension-evidence { display: block; margin-top: 6rpx; color: var(--muted); font-size: 22rpx; line-height: 1.5; }
.reason-card { background: var(--surface-warm); }
.reason-line { display: block; margin-top: 14rpx; color: var(--muted); font-size: 23rpx; line-height: 1.55; }
.agent-card { border-color: rgba(251, 113, 133, 0.24); background: linear-gradient(145deg, #ffffff, #fff7f8); }
.agent-title { margin-top: 18rpx; }
.source-heading { display: block; margin-top: 26rpx; color: var(--text); font-size: 24rpx; font-weight: 800; }
