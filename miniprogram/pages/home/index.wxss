.hero {
  position: relative;
  min-height: 318rpx;
  padding: 24rpx 12rpx 28rpx;
}

.hero::before,
.hero::after {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
  content: "";
}

.hero::before {
  top: -10rpx;
  right: 6rpx;
  width: 112rpx;
  height: 112rpx;
  border: 18rpx solid rgba(250, 204, 21, 0.3);
  animation: soft-pulse 3.2s ease-in-out infinite;
}

.hero::after {
  top: 92rpx;
  right: 96rpx;
  width: 34rpx;
  height: 34rpx;
  background: var(--coral);
  box-shadow: 44rpx 62rpx 0 rgba(251, 146, 60, 0.72);
}

.hero .page-title { max-width: 570rpx; }

.progress-card {
  position: relative;
  margin-top: 20rpx;
  overflow: visible;
  border-color: rgba(251, 146, 60, 0.26);
  background: linear-gradient(145deg, #ffffff 0%, #fff7ed 100%);
}

.progress-card::before {
  position: absolute;
  top: -8rpx;
  right: 34rpx;
  left: 34rpx;
  z-index: -1;
  height: 28rpx;
  border-radius: 30rpx 30rpx 0 0;
  background: linear-gradient(90deg, var(--orange), var(--coral), var(--sun));
  opacity: 0.58;
  content: "";
}

.progress-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 24rpx; }
.progress-number { color: var(--primary); font-size: 50rpx; font-weight: 900; }
.progress-track { height: 14rpx; margin-top: 28rpx; overflow: hidden; border-radius: 999rpx; background: var(--primary-soft); }
.progress-fill { height: 100%; border-radius: inherit; background: linear-gradient(90deg, var(--primary), var(--orange), var(--sun)); transition: width 300ms ease; }
.status-row { display: flex; justify-content: space-between; gap: 8rpx; margin-top: 18rpx; }
.status-item { flex: 1; padding: 10rpx 6rpx; border-radius: 999rpx; color: #9a7966; font-size: 20rpx; text-align: center; background: var(--surface-warm); }
.status-item.done { color: var(--success); background: var(--success-soft); }
.agent-entry { display: flex; align-items: center; border-color: rgba(251, 113, 133, 0.26); background: linear-gradient(145deg, #ffffff, var(--coral-soft)); }
.agent-entry-icon { display: flex; align-items: center; justify-content: center; flex: 0 0 72rpx; width: 72rpx; height: 72rpx; border-radius: 24rpx; color: #ffffff; font-size: 28rpx; font-weight: 900; background: var(--coral); }
.agent-entry-copy { flex: 1; margin-left: 20rpx; }
.agent-entry-copy .card-copy { margin-top: 6rpx; font-size: 21rpx; }
.agent-entry-arrow { color: var(--primary); font-size: 36rpx; font-weight: 900; }

.loop-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18rpx; }
.loop-item { min-height: 190rpx; padding: 24rpx; border: 1rpx solid var(--line); border-radius: 30rpx; background: #ffffff; box-shadow: 0 12rpx 30rpx rgba(124, 70, 30, 0.07); transition: transform 180ms ease; }
.loop-item:active { transform: scale(0.97); }
.loop-item:nth-child(1) { background: var(--primary-soft); }
.loop-item:nth-child(2) { background: var(--coral-soft); }
.loop-item:nth-child(3) { background: var(--sun-soft); }
.loop-item:nth-child(4) { background: var(--success-soft); }
.loop-index { display: inline-flex; align-items: center; justify-content: center; width: 50rpx; height: 50rpx; border-radius: 50%; color: #ffffff; font-size: 19rpx; font-weight: 850; background: var(--primary); }
.loop-item:nth-child(2) .loop-index { background: var(--coral); }
.loop-item:nth-child(3) .loop-index { color: var(--text); background: var(--sun); }
.loop-item:nth-child(4) .loop-index { background: var(--success); }
.loop-name { display: block; margin-top: 14rpx; color: var(--text); font-size: 28rpx; font-weight: 800; }
.loop-copy { display: block; margin-top: 8rpx; color: var(--muted); font-size: 22rpx; line-height: 1.5; }
.notice-card { margin-top: 36rpx; border-color: rgba(250, 204, 21, 0.45); background: linear-gradient(145deg, #ffffff, #fffbea); }
.notice-title { margin-top: 18rpx; }

@media (prefers-reduced-motion: reduce) {
  .hero::before { animation: none; }
}

.onboard-card { width: 600rpx; padding: 56rpx 44rpx 40rpx; text-align: center; border-radius: 36rpx; background: linear-gradient(180deg, #fffaf2 0%, #ffffff 100%); box-shadow: 0 30rpx 80rpx rgba(59, 36, 22, 0.35); animation: celebration-pop 0.45s cubic-bezier(0.2, 1.6, 0.4, 1); }
.onboard-emoji { display: block; font-size: 88rpx; line-height: 1.2; }
.onboard-title { display: block; margin-top: 20rpx; color: var(--text); font-size: 38rpx; font-weight: 900; line-height: 1.35; }
.onboard-copy { display: block; margin-top: 16rpx; color: var(--muted); font-size: 26rpx; line-height: 1.7; }
.onboard-button { margin-top: 36rpx; }
.onboard-choice { display: block; margin-top: 20rpx; padding: 0 28rpx; text-align: left; border: 2rpx solid var(--line); border-radius: 24rpx; color: var(--text); font-size: 27rpx; font-weight: 700; line-height: 96rpx; background: var(--surface-soft); }
.onboard-choice::after { border: 0; }
.onboard-dots { display: flex; justify-content: center; margin-top: 36rpx; }
.onboard-dot { width: 12rpx; height: 12rpx; margin: 0 7rpx; border-radius: 50%; background: #ecd9c6; }
.onboard-dot.active { background: var(--primary); }

.onboard-mask { z-index: 999; background: rgba(59, 36, 22, 0.78); }
